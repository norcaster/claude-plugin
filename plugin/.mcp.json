{
  "mcpServers": {
    "norcaster": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.mjs"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_API_KEY": "${user_config.api_key}",
        "CLAUDE_PLUGIN_OPTION_DEPLOYMENT_ID": "${user_config.deployment_id}",
        "CLAUDE_PLUGIN_OPTION_API_URL": "${user_config.api_url}",
        "CLAUDE_PLUGIN_OPTION_PORTAL_URL": "${user_config.portal_url}"
      }
    }
  }
}
